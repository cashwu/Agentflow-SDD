#!/usr/bin/env fish

set script_path (status --current-filename)
set test_dir (dirname "$script_path")
set root_dir (realpath "$test_dir/../../..")
set generator "$root_dir/scripts/spectra-plus/generate.fish"
set rules "$root_dir/scripts/spectra-plus/rules.yaml"
set propose "$root_dir/.claude/skills/spectra-propose-plus/SKILL.md"
set apply "$root_dir/.claude/skills/spectra-apply-plus/SKILL.md"
set propose_codex "$root_dir/.agents/skills/spectra-propose-plus/SKILL.md"
set apply_codex "$root_dir/.agents/skills/spectra-apply-plus/SKILL.md"
set propose_outputs "$propose" "$propose_codex"
set apply_outputs "$apply" "$apply_codex"
set all_outputs $propose_outputs $apply_outputs
set marker "<!-- Generated by scripts/spectra-plus/generate.fish — DO NOT EDIT MANUALLY -->"
set plus_version "1.5.0"
set plus_updated "2026-07-16"
set fish_bin (command -s fish)

function fail
    echo "FAIL: $argv" >&2
    exit 1
end

function assert_contains
    set file $argv[1]
    set text $argv[2]
    rg -q --fixed-strings -- "$text" "$file"; or fail "$file missing $text"
end

function assert_contains_between
    set file $argv[1]
    set start_text $argv[2]
    set end_text $argv[3]
    set text $argv[4]
    awk -v start="$start_text" -v stop="$end_text" -v text="$text" '
        index($0, start) { started = 1; in_block = 1; next }
        in_block && index($0, stop) { stopped = 1; in_block = 0; next }
        in_block && index($0, text) { found = 1 }
        END { exit started && stopped && found ? 0 : 1 }
    ' "$file"; or fail "$file missing $text between $start_text and $end_text"
end

function assert_not_contains
    set file $argv[1]
    set text $argv[2]
    if rg -q --fixed-strings -- "$text" "$file"
        fail "$file unexpectedly contains $text"
    end
end

function assert_not_contains_i
    set file $argv[1]
    set text $argv[2]
    if rg -qi --fixed-strings -- "$text" "$file"
        fail "$file unexpectedly contains (case-insensitive) $text"
    end
end

function first_line_number
    set file $argv[1]
    set text $argv[2]
    rg -n --fixed-strings -- "$text" "$file" | head -n 1 | cut -d: -f1
end

function assert_line_order
    set file $argv[1]
    set first $argv[2]
    set second $argv[3]
    set first_line (first_line_number "$file" "$first")
    set second_line (first_line_number "$file" "$second")
    test -n "$first_line"; or fail "$file missing order anchor $first"
    test -n "$second_line"; or fail "$file missing order anchor $second"
    test "$first_line" -lt "$second_line"; or fail "$file expected $first before $second"
end

function assert_step_numbers_sequential
    set file $argv[1]
    awk '
        /^[0-9]+\. \*\*/ {
            expected++
            actual = $1
            sub(/\.$/, "", actual)
            if (actual != expected) {
                printf("step numbering mismatch: expected %d got %s at line %d\n", expected, actual, NR) > "/dev/stderr"
                exit 1
            }
        }
    ' "$file"; or fail "$file has non-sequential step numbering"
end

function assert_frontmatter_contains
    set file $argv[1]
    set text $argv[2]
    awk -v text="$text" '
        NR == 1 && $0 == "---" { in_fm = 1; next }
        in_fm && $0 == "---" { exit }
        in_fm && $0 == text { found = 1; exit }
        END { exit found ? 0 : 1 }
    ' "$file"; or fail "$file frontmatter missing $text"
end

function output_fingerprint
    for file in $all_outputs
        cksum "$file"
    end
end

function snapshot_tree --argument-names root
    if not test -e "$root"
        echo "<missing>"
        return
    end

    find "$root" -type f -print | sort | while read -l file
        set relative (string replace -- "$root/" "" "$file")
        set mode (stat -f %Lp "$file")
        set checksum (cksum < "$file" | string trim)
        printf '%s\t%s\t%s\n' "$relative" "$mode" "$checksum"
    end
end

function make_fingerprint_fixture --argument-names fixture
    command rm -rf "$fixture"
    mkdir -p "$fixture/source/scripts/spectra-plus" \
        "$fixture/target/.agents/skills" \
        "$fixture/target/.claude/skills" \
        "$fixture/fish-config/fish/conf.d"

    printf 'printf CONFIG_POLLUTION_FROM_FISH_CONFIG\n' > "$fixture/fish-config/fish/conf.d/protocol-pollution.fish"

    command cp -f "$generator" "$fixture/source/scripts/spectra-plus/generate.fish"
    command cp -f "$rules" "$fixture/source/scripts/spectra-plus/rules.yaml"
    command cp -R "$root_dir/scripts/spectra-plus/template" "$fixture/source/scripts/spectra-plus/template"

    for family in .agents .claude
        for skill in spectra-apply spectra-propose
            mkdir -p "$fixture/target/$family/skills/$skill"
            command cp -f "$root_dir/$family/skills/$skill/SKILL.md" "$fixture/target/$family/skills/$skill/SKILL.md"
        end
        for skill in spectra-apply-plus spectra-propose-plus
            mkdir -p "$fixture/target/$family/skills/$skill"
            printf 'QUERY_OUTPUT_SENTINEL:%s/%s\n' "$family" "$skill" > "$fixture/target/$family/skills/$skill/SKILL.md"
            chmod 640 "$fixture/target/$family/skills/$skill/SKILL.md"
        end
    end

    for state_path in registry lock cache throttle
        printf 'QUERY_STATE_SENTINEL:%s\n' "$state_path" > "$fixture/target/.spectra-plus-$state_path"
        chmod 600 "$fixture/target/.spectra-plus-$state_path"
    end
end

function query_fingerprints --argument-names fixture
    env XDG_CONFIG_HOME="$fixture/fish-config" "$fixture/source/scripts/spectra-plus/generate.fish" \
        --root "$fixture/target" --fingerprints \
        >/tmp/spectra-plus-fingerprint.out 2>/tmp/spectra-plus-fingerprint.err
end

function query_fingerprints_with_path --argument-names fixture tool_path
    env PATH="$tool_path" "$fish_bin" --no-config "$fixture/source/scripts/spectra-plus/generate.fish" \
        --root "$fixture/target" --fingerprints \
        >/tmp/spectra-plus-fingerprint.out 2>/tmp/spectra-plus-fingerprint.err
end

function assert_fingerprint_query_shape --argument-names output_file
    set expected_keys \
        "spectra-apply-plus\tclaude" \
        "spectra-apply-plus\tcodex" \
        "spectra-propose-plus\tclaude" \
        "spectra-propose-plus\tcodex"
    set rows (string split \n -- (string collect < "$output_file"))
    test (count $rows) -eq 4; or fail "fingerprint query must emit exactly four rows"

    set seen
    for index in (seq 1 4)
        set fields (string split (printf '\t') -- "$rows[$index]")
        test (count $fields) -eq 3; or fail "fingerprint row must have exactly three fields: $rows[$index]"
        test "$fields[1]\t$fields[2]" = "$expected_keys[$index]"; or fail "unexpected fingerprint key/order: $rows[$index]"
        string match -qr '^[0-9]+$' -- "$fields[3]"; or fail "fingerprint must be a non-empty decimal token: $rows[$index]"
        contains -- "$fields[1]/$fields[2]" $seen; and fail "duplicate fingerprint key: $fields[1]/$fields[2]"
        set seen $seen "$fields[1]/$fields[2]"
    end
end

function fingerprint_for_key --argument-names output_file skill variant
    awk -F '\t' -v skill="$skill" -v variant="$variant" \
        '$1 == skill && $2 == variant { print $3 }' "$output_file"
end

function assert_all_fingerprints_changed --argument-names baseline_file changed_file cause
    for key in apply-claude apply-codex propose-claude propose-codex
        set parts (string split -m1 - $key)
        set skill "spectra-$parts[1]-plus"
        set baseline (fingerprint_for_key "$baseline_file" "$skill" "$parts[2]")
        set changed (fingerprint_for_key "$changed_file" "$skill" "$parts[2]")
        test "$baseline" != "$changed"; or fail "$cause did not change $key fingerprint"
    end
end

function assert_query_failure_read_only --argument-names fixture expected_text
    set before_source (snapshot_tree "$fixture/source" | string collect)
    set before_target (snapshot_tree "$fixture/target" | string collect)
    set before_legacy_temp (snapshot_tree /tmp/spectra-plus-yq.err | string collect)
    query_fingerprints "$fixture"
    set actual $status
    test "$actual" -ne 0; or fail "fingerprint query unexpectedly succeeded"
    test ! -s /tmp/spectra-plus-fingerprint.out; or fail "failed fingerprint query emitted partial stdout"
    assert_contains /tmp/spectra-plus-fingerprint.err "$expected_text"
    set after_source (snapshot_tree "$fixture/source" | string collect)
    set after_target (snapshot_tree "$fixture/target" | string collect)
    set after_legacy_temp (snapshot_tree /tmp/spectra-plus-yq.err | string collect)
    test "$before_source" = "$after_source"; or fail "failed fingerprint query modified source inputs"
    test "$before_target" = "$after_target"; or fail "failed fingerprint query modified target inputs, outputs, or state"
    test "$before_legacy_temp" = "$after_legacy_temp"; or fail "failed fingerprint query modified legacy yq temp state"
end

function run_expect
    set expected $argv[1]
    set command $argv[2..-1]
    $command >/tmp/spectra-plus-test.out 2>/tmp/spectra-plus-test.err
    set actual $status
    test "$actual" -eq "$expected"; or begin
        cat /tmp/spectra-plus-test.out
        cat /tmp/spectra-plus-test.err >&2
        fail "expected exit $expected, got $actual: $command"
    end
end

function run_with_bad_rules_expect
    set expected $argv[1]
    set bad_rules $argv[2]
    set command $argv[3..-1]
    command cp -f "$rules" /tmp/spectra-plus-rules.backup
    command cp -f "$bad_rules" "$rules"
    $command >/tmp/spectra-plus-test.out 2>/tmp/spectra-plus-test.err
    set actual $status
    command cp -f /tmp/spectra-plus-rules.backup "$rules"
    test "$actual" -eq "$expected"; or begin
        cat /tmp/spectra-plus-test.out
        cat /tmp/spectra-plus-test.err >&2
        fail "expected exit $expected, got $actual: $command"
    end
end

cd "$root_dir"; or fail "cannot cd to root"

yq '.' "$rules" >/dev/null; or fail "rules.yaml did not parse"

# Content-derived fingerprint query: fixed protocol, deterministic inputs, and strict read-only behavior.
set fingerprint_fixture_a /tmp/spectra-plus-fingerprint-a
set fingerprint_fixture_b /tmp/spectra-plus-fingerprint-b
make_fingerprint_fixture "$fingerprint_fixture_a"
make_fingerprint_fixture "$fingerprint_fixture_b"

set before_query_source (snapshot_tree "$fingerprint_fixture_a/source" | string collect)
set before_query_target (snapshot_tree "$fingerprint_fixture_a/target" | string collect)
set before_query_legacy_temp (snapshot_tree /tmp/spectra-plus-yq.err | string collect)
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or begin
    cat /tmp/spectra-plus-fingerprint.err >&2
    fail "fingerprint query failed"
end
assert_fingerprint_query_shape /tmp/spectra-plus-fingerprint.out
command cp -f /tmp/spectra-plus-fingerprint.out /tmp/spectra-plus-fingerprint.baseline
set after_query_source (snapshot_tree "$fingerprint_fixture_a/source" | string collect)
set after_query_target (snapshot_tree "$fingerprint_fixture_a/target" | string collect)
set after_query_legacy_temp (snapshot_tree /tmp/spectra-plus-yq.err | string collect)
test "$before_query_source" = "$after_query_source"; or fail "successful fingerprint query modified source inputs"
test "$before_query_target" = "$after_query_target"; or fail "successful fingerprint query modified target inputs, outputs, or state"
test "$before_query_legacy_temp" = "$after_query_legacy_temp"; or fail "successful fingerprint query modified legacy yq temp state"

query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "repeated fingerprint query failed"
diff -u /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out; or fail "fingerprint query is not repeatable"

query_fingerprints "$fingerprint_fixture_b"
test $status -eq 0; or fail "relocated fingerprint query failed"
diff -u /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out; or fail "fingerprint depends on absolute root path"

# Only the apply/codex fingerprint consumes this base source.
echo "BASE_FINGERPRINT_MUTATION" >> "$fingerprint_fixture_a/target/.agents/skills/spectra-apply/SKILL.md"
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "base mutation fingerprint query failed"
set baseline_apply_codex (fingerprint_for_key /tmp/spectra-plus-fingerprint.baseline spectra-apply-plus codex)
set changed_apply_codex (fingerprint_for_key /tmp/spectra-plus-fingerprint.out spectra-apply-plus codex)
test "$baseline_apply_codex" != "$changed_apply_codex"; or fail "base source mutation did not change its fingerprint"
command cp -f "$root_dir/.agents/skills/spectra-apply/SKILL.md" "$fingerprint_fixture_a/target/.agents/skills/spectra-apply/SKILL.md"

echo "# GENERATOR_FINGERPRINT_MUTATION" >> "$fingerprint_fixture_a/source/scripts/spectra-plus/generate.fish"
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "generator mutation fingerprint query failed"
assert_all_fingerprints_changed /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out "generator mutation"
command cp -f "$generator" "$fingerprint_fixture_a/source/scripts/spectra-plus/generate.fish"

command cp -f "$fingerprint_fixture_a/source/scripts/spectra-plus/rules.yaml" /tmp/spectra-plus-fingerprint-rules.clean
yq '.skills."spectra-propose-plus".metadata.description = "fingerprint rules mutation"' \
    /tmp/spectra-plus-fingerprint-rules.clean > "$fingerprint_fixture_a/source/scripts/spectra-plus/rules.yaml"
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "rules mutation fingerprint query failed"
assert_all_fingerprints_changed /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out "rules mutation"
command cp -f /tmp/spectra-plus-fingerprint-rules.clean "$fingerprint_fixture_a/source/scripts/spectra-plus/rules.yaml"

set referenced_template "$fingerprint_fixture_a/source/scripts/spectra-plus/template/review-loop-block.md"
command cp -f "$referenced_template" /tmp/spectra-plus-fingerprint-template.clean
echo "REFERENCED_TEMPLATE_FINGERPRINT_MUTATION" >> "$referenced_template"
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "referenced-template mutation fingerprint query failed"
assert_all_fingerprints_changed /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out "referenced-template mutation"
command cp -f /tmp/spectra-plus-fingerprint-template.clean "$referenced_template"

echo "ORPHAN_TEMPLATE_MUST_NOT_AFFECT_FINGERPRINT" > "$fingerprint_fixture_a/source/scripts/spectra-plus/template/orphan-fingerprint-test.md"
query_fingerprints "$fingerprint_fixture_a"
test $status -eq 0; or fail "orphan-template fingerprint query failed"
diff -u /tmp/spectra-plus-fingerprint.baseline /tmp/spectra-plus-fingerprint.out; or fail "orphan template affected fingerprints"
command rm -f "$fingerprint_fixture_a/source/scripts/spectra-plus/template/orphan-fingerprint-test.md"

command rm -f "$fingerprint_fixture_a/target/.claude/skills/spectra-propose/SKILL.md"
assert_query_failure_read_only "$fingerprint_fixture_a" "fingerprint input not found: base:.claude/skills/spectra-propose/SKILL.md"
make_fingerprint_fixture "$fingerprint_fixture_a"

printf 'skills: [invalid\n' > "$fingerprint_fixture_a/source/scripts/spectra-plus/rules.yaml"
assert_query_failure_read_only "$fingerprint_fixture_a" "rules.yaml parse error"
make_fingerprint_fixture "$fingerprint_fixture_a"

set missing_cksum_path /tmp/spectra-plus-no-cksum-bin
command rm -rf "$missing_cksum_path"
mkdir -p "$missing_cksum_path"
for tool in dirname realpath yq date cat seq
    command ln -s (command -s "$tool") "$missing_cksum_path/$tool"
end
set before_missing_cksum (snapshot_tree "$fingerprint_fixture_a" | string collect)
query_fingerprints_with_path "$fingerprint_fixture_a" "$missing_cksum_path"
test $status -ne 0; or fail "query unexpectedly succeeded without cksum"
test ! -s /tmp/spectra-plus-fingerprint.out; or fail "missing cksum emitted partial stdout"
assert_contains /tmp/spectra-plus-fingerprint.err "fingerprint error: cksum is required"
set after_missing_cksum (snapshot_tree "$fingerprint_fixture_a" | string collect)
test "$before_missing_cksum" = "$after_missing_cksum"; or fail "missing cksum query modified fixture"

set failing_cksum_path /tmp/spectra-plus-failing-cksum-bin
command rm -rf "$failing_cksum_path"
mkdir -p "$failing_cksum_path"
printf '#!/bin/sh\necho "injected cksum failure" >&2\nexit 9\n' > "$failing_cksum_path/cksum"
chmod +x "$failing_cksum_path/cksum"
set before_failing_cksum (snapshot_tree "$fingerprint_fixture_a" | string collect)
query_fingerprints_with_path "$fingerprint_fixture_a" "$failing_cksum_path:/opt/homebrew/bin:/usr/bin:/bin"
test $status -ne 0; or fail "query unexpectedly succeeded when cksum failed"
test ! -s /tmp/spectra-plus-fingerprint.out; or fail "checksum failure emitted partial stdout"
assert_contains /tmp/spectra-plus-fingerprint.err "cksum"
set after_failing_cksum (snapshot_tree "$fingerprint_fixture_a" | string collect)
test "$before_failing_cksum" = "$after_failing_cksum"; or fail "checksum failure query modified fixture"

run_expect 0 "$generator" --help
run_expect 0 "$generator"

test -f "$propose"; or fail "missing propose plus output"
test -f "$apply"; or fail "missing apply plus output"
assert_contains "$propose" "$marker"
assert_contains "$apply" "$marker"

assert_contains "$propose" "name: spectra-propose-plus"
assert_contains "$apply" "name: spectra-apply-plus"

# TDD guard: the current generated output must fail here until the new review-loop
# contract is implemented and regenerated.
for skill_path in $all_outputs
    assert_contains "$skill_path" "Graded convergence and micro-verification round"
    assert_contains "$skill_path" 'Every `fix-introduced` finding MUST include `introduced_by`'
end

for skill_path in $all_outputs
    assert_frontmatter_contains "$skill_path" "  spectraPlusVersion: $plus_version"
    assert_frontmatter_contains "$skill_path" "  spectraPlusUpdated: $plus_updated"
    awk '
        NR == 1 && $0 == "---" { in_fm = 1; next }
        in_fm && $0 == "---" { exit }
        in_fm && $0 ~ /^  spectraPlusFingerprint: [0-9]+$/ { found = 1; exit }
        END { exit found ? 0 : 1 }
    ' "$skill_path"; or fail "$skill_path frontmatter missing decimal spectraPlusFingerprint"
end
assert_not_contains "$propose" "spectra park"
assert_contains "$propose" "review/rating/fix"
assert_contains "$apply" "review/rating/fix"
assert_contains "$apply" "ai 的回覆要用中文"
assert_contains "$apply" "Implementation Notes Protocol"
assert_contains "$apply" "implementation-notes.md"
assert_not_contains "$propose" "Implementation Notes Protocol"

# Generated skill identity: only invocation/override examples become plus commands.
assert_contains "$propose" '**Input**: The argument after `/spectra-propose-plus` is the requirement description.'
assert_contains "$propose" '- `/spectra-propose-plus add dark mode`'
assert_not_contains "$propose" '**Input**: The argument after `/spectra-propose` is the requirement description.'
assert_contains "$propose_codex" '**Input**: The argument after `$spectra-propose-plus` is the requirement description.'
assert_contains "$propose_codex" '- `$spectra-propose-plus add dark mode`'
assert_not_contains "$propose_codex" '**Input**: The argument after `$spectra-propose` is the requirement description.'

assert_contains "$apply" '(e.g., `/spectra-apply-plus add-auth`)'
assert_contains "$apply" 'how to override (e.g., `/spectra-apply-plus <other>`)'
assert_not_contains "$apply" '(e.g., `/spectra-apply add-auth`)'
assert_not_contains "$apply" 'how to override (e.g., `/spectra-apply <other>`)'
assert_contains "$apply_codex" '(e.g., `$spectra-apply-plus add-auth`)'
assert_contains "$apply_codex" 'how to override (e.g., `$spectra-apply-plus <other>`)'
assert_not_contains "$apply_codex" '(e.g., `$spectra-apply add-auth`)'
assert_not_contains "$apply_codex" 'how to override (e.g., `$spectra-apply <other>`)'

# Base workflow references outside invocation/override examples are intentional.
assert_contains "$propose" 'Do NOT invoke `/spectra-apply`.'
assert_contains "$propose_codex" 'Do NOT invoke `$spectra-apply`.'
assert_contains "$apply" 'suggest using `/spectra-propose` to create the change artifacts first'
assert_contains "$apply_codex" 'suggest using `$spectra-propose` to create the change artifacts first'

for skill_path in $all_outputs
    assert_not_contains "$skill_path" "spectra-propose-plus-plus"
    assert_not_contains "$skill_path" "spectra-apply-plus-plus"
end

set codex_propose_base "$root_dir/.agents/skills/spectra-propose/SKILL.md"
for skill_path in "$codex_propose_base" "$propose_codex"
    assert_contains "$skill_path" "check whether that exact conversation-provided plan file path exists"
    assert_not_contains "$skill_path" 'file exists at ``'
end

# Parallel reviewers + confidence filter behavior — both plus skills share review-loop-block
# Assert across both claude and codex variants to lock template + rules behavior.
for skill_path in $propose_outputs $apply_outputs
    assert_contains "$skill_path" "Reviewer A — Adherence"
    assert_contains "$skill_path" "Reviewer B — Quality"
    assert_contains "$skill_path" "Confidence scoring rubric"
    assert_contains "$skill_path" "Confidence filter"
    assert_contains "$skill_path" "Common false positives"
    assert_contains "$skill_path" "Direct artifact-requirement violations MUST score"
    # Rater removed: no rater sub-agent role and no quality_score field in any variant.
    assert_not_contains_i "$skill_path" "rater"
    assert_not_contains "$skill_path" "quality_score"
    # Mechanical decision rule derived by the main agent after the confidence filter.
    assert_contains "$skill_path" "blocking `Critical`"
    assert_contains "$skill_path" "blocking `Warning`"
    # Graded convergence + micro-verification round contract.
    assert_contains "$skill_path" "Graded convergence and micro-verification round"
    assert_contains "$skill_path" "Reviewer V — Verification"
    assert_contains "$skill_path" "Each micro round MUST spawn exactly ONE fresh sub-agent"
    assert_not_contains "$skill_path" "Every other round after the first MUST spawn exactly ONE fresh sub-agent"
    assert_contains "$skill_path" "`round_type`"
    assert_contains "$skill_path" "`layer`"
    assert_contains "$skill_path" "the fourth round of the current run"
    assert_contains "$skill_path" "Consecutive micro rounds are valid"
    assert_contains "$skill_path" "the fourth-round checkpoint is the only full re-scan after the run's first round"
    assert_contains "$skill_path" '`disposition`: one of `unresolved-prior`, `fix-introduced`, or `new`'
    assert_contains "$skill_path" "A surviving `Critical` or `Warning` finding is blocking if and only if"
    assert_contains "$skill_path" "cumulative blocking set"
    assert_contains "$skill_path" "explicit resolved/unresolved verdict per member"
    assert_contains "$skill_path" 'When a reviewer cannot decide between `design` and `text`, it MUST classify the finding as `design`.'
    assert_contains "$skill_path" 'The main agent MUST NOT reclassify a `design` finding to `text`.'
    assert_contains "$skill_path" 'merged finding MUST take `layer == design`'
    assert_not_contains "$skill_path" "MUST NOT be followed by another micro round"
    assert_not_contains "$skill_path" 'the next round is `micro` if and only if the current round is `full`, no Critical findings survive, and every surviving Warning has `layer == text`'
    assert_not_contains "$skill_path" 'Re-derivation MUST only change `micro` to `full`'
    assert_not_contains "$skill_path" "cannot determine whether a post-decision modification only synchronizes text"
    assert_not_contains "$skill_path" "(or, for apply-plus, any implementation-file modification)"
    assert_not_contains "$skill_path" "re-derivation note"
    # Accepted risks, delta evidence, circuit breaker, abort triage, and action obligation.
    assert_contains "$skill_path" "Accepted-risks ledger"
    assert_contains "$skill_path" "openspec/changes/<change>/reviews/accepted-risks.md"
    assert_contains "$skill_path" "same artifact or file and the same defect mechanism"
    assert_contains "$skill_path" "confidence ≤ 25"
    assert_contains "$skill_path" "same subsystem alone MUST NOT trigger the downgrade"
    assert_contains "$skill_path" "Fix-loop design circuit breaker"
    assert_contains "$skill_path" "`needs-design` note"
    assert_contains "$skill_path" "Abort triage"
    assert_contains "$skill_path" "bucket 1"
    assert_contains "$skill_path" "bucket 2"
    assert_contains "$skill_path" "bucket 3"
